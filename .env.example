# ==============================================================================
# Switchyard Environment Configuration
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Switchyard"
API_V1_PREFIX=/api/v1
PORT=8001
FRONTEND_PORT=3001

# Persistence & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/switchyard_db
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-this-to-a-very-secure-random-64-character-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Configuration (Default: Local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:latest
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
PROMETHEUS_METRICS=true
